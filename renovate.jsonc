{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // No aqua preset: this repo has no aqua.yaml — its CI tooling is npm.
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  "minimumReleaseAge": "3 days",

  // npm's resolution-time cooldown (min-release-age in .npmrc) needs this floor,
  // otherwise the flag is ignored and lockFileMaintenance pulls same-day releases.
  "constraints": {
    "npm": ">=11.10.0"
  },

  // Use the OSV database on top of GitHub's advisories — it is what surfaces the
  // transitive alerts in package-lock.json that GitHub is slow to report.
  "osvVulnerabilityAlerts": true,

  "vulnerabilityAlerts": {
    "description": [
      "Security updates get a shorter soak, not none.",
      "Waiting the full 3 days on a known CVE is its own risk, but merging a release",
      "published minutes ago — unattended, straight into the cluster — is exactly the",
      "case the age gate exists for: a poisoned release is least likely to have been",
      "noticed while it is brand new. Most advisory fix versions are already older",
      "than this by the time the advisory lands, so in practice this delays almost",
      "nothing."
    ],
    "minimumReleaseAge": "1 day",
    "schedule": ["at any time"],
    "labels": ["security"]
  },

  "lockFileMaintenance": {
    "description": [
      "Most open alerts are transitive dependencies in package-lock.json, which no",
      "direct-dependency bump reaches. Automerged because the build job installs",
      "from the refreshed lock file and runs tsc against it."
    ],
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },

  // Merge directly rather than queueing on GitHub: this repo has no required
  // checks that platform automerge would wait on.
  "platformAutomerge": false,

  "packageRules": [
    {
      // Written as a packageRule rather than a top-level `docker` block, which is
      // the pre-migration spelling Renovate rewrites on sight.
      "description": "Pin docker digests; the digest-cooldown workflow soaks them before merge",
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Automerge all devDependencies",
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "Automerge runtime patch/digest",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge minor for hono ecosystem (we follow upstream closely)",
      // matchPackagePatterns is removed; a slash-delimited entry in
      // matchPackageNames is the regex form that replaced it.
      "matchPackageNames": ["/^@?hono(/.*)?$/"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Pin claude-code-action until anthropics/claude-code-action#1260 lands (Issue #1242)",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["anthropics/claude-code-action"],
      "allowedVersions": "<=1.0.99"
    },
    {
      "description": [
        "Leave the reusable-workflow ref in claude-review.yml alone. It points at",
        "@main deliberately: claude-code-action validates its entry-point workflow",
        "against the default branch, so any PR that edits that caller cannot be",
        "reviewed. Pinning it to a SHA would put it back in this bot's path on every",
        "change to the reusable body — exactly the failure the split removes."
      ],
      "matchManagers": ["github-actions"],
      "matchDepNames": ["Tsuguya/memory"],
      "enabled": false
    }
  ]
}
